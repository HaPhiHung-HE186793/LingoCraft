{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/lingocraft/game-spec.schema.json",
  "title": "Public Scene Builder GameSpec v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "template_id": {
      "const": "scene_builder_v1"
    },
    "renderer_version": {
      "const": "1.0.0"
    },
    "game_id": {
      "type": "string",
      "format": "uuid"
    },
    "ui_locale": {
      "const": "vi-VN"
    },
    "target_language": {
      "enum": [
        "en",
        "ja"
      ]
    },
    "title_vi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "objective_vi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "prompt_vi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "item_id",
          "revision_id"
        ],
        "additionalProperties": false
      }
    },
    "scene": {
      "type": "object",
      "properties": {
        "description_vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^node_[a-z0-9_]{1,32}$"
              },
              "icon_id": {
                "enum": [
                  "person",
                  "bicycle",
                  "school",
                  "university",
                  "company",
                  "bus",
                  "left_turn",
                  "right_turn",
                  "traffic_light",
                  "supermarket",
                  "straight",
                  "landmark"
                ]
              },
              "label_vi": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "id",
              "icon_id",
              "label_vi"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^node_[a-z0-9_]{1,32}$"
              },
              "to": {
                "type": "string",
                "pattern": "^node_[a-z0-9_]{1,32}$"
              },
              "relation": {
                "enum": [
                  "travels_by",
                  "goes_to",
                  "turns_at",
                  "next_to",
                  "follows"
                ]
              }
            },
            "required": [
              "from",
              "to",
              "relation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "description_vi",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "tokens": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tok_[a-z0-9_]{1,32}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "reading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "interaction": {
      "type": "object",
      "properties": {
        "input_modes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "tap",
              "keyboard",
              "drag"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "tap"
              }
            },
            {
              "contains": {
                "const": "keyboard"
              }
            }
          ]
        },
        "max_answer_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "input_modes",
        "max_answer_tokens"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "template_id",
    "renderer_version",
    "game_id",
    "ui_locale",
    "target_language",
    "title_vi",
    "objective_vi",
    "prompt_vi",
    "source_refs",
    "scene",
    "tokens",
    "interaction"
  ],
  "additionalProperties": false
}