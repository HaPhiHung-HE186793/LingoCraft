{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example.invalid/lingocraft/private-answer-key.schema.json",
  "title": "Server-only key for Scene Builder v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "game_id": {
      "type": "string",
      "format": "uuid"
    },
    "canonical_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "accepted_token_sequences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "string",
          "pattern": "^tok_[a-z0-9_]{1,32}$"
        }
      }
    },
    "semantic_slots": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "hints": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "kind": {
            "enum": [
              "grammar",
              "semantic",
              "partial_answer",
              "full_answer"
            ]
          },
          "text_vi": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "reveals_answer": {
            "type": "boolean"
          }
        },
        "required": [
          "level",
          "kind",
          "text_vi",
          "reveals_answer"
        ],
        "additionalProperties": false
      }
    },
    "memory_effect": {
      "const": "practice_only"
    },
    "review_status": {
      "enum": [
        "draft",
        "expert_reviewed"
      ]
    }
  },
  "required": [
    "schema_version",
    "game_id",
    "canonical_text",
    "accepted_token_sequences",
    "semantic_slots",
    "hints",
    "memory_effect",
    "review_status"
  ],
  "additionalProperties": false
}