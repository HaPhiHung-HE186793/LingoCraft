# LingoCraft API — Environment Variables
# Copy this file to .env (git-ignored) and fill in real values.
# NEVER commit .env with real secrets.
#
# For Neon: get values from your Neon project dashboard → Connection Details.
# For Clerk: see docs/setup/clerk-setup.md for step-by-step guide.

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Runtime role — uses Neon's transaction pooler URL (lc_app user)
DATABASE_URL_APP=postgresql://lc_app:<password>@<neon-pooler-host>/<dbname>?sslmode=require

# Migration role — uses Neon's direct (non-pooler) connection (lc_migrate user)
# Only used by: packages/database/src/migrate.ts
# Never used by: API or worker at runtime
DATABASE_URL_MIGRATE=postgresql://lc_migrate:<password>@<neon-direct-host>/<dbname>?sslmode=require

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
# From: Clerk Dashboard → Your Application → API Keys
# See: docs/setup/clerk-setup.md for how to get these
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3001
APP_VERSION=0.0.1-dev

# ── Worker ────────────────────────────────────────────────────────────────────
# (same DATABASE_URL_APP as API — worker uses lc_app role)

# ── Media (R2/S3-compatible) — M2+ ───────────────────────────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# ── AI providers — M2+ ───────────────────────────────────────────────────────
# AI_PROVIDER=
# OPENAI_API_KEY=
