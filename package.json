{
  "name": "lingocraft",
  "version": "0.0.1",
  "private": true,
  "description": "LingoCraft — personal language workshop monorepo",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --filter './packages/**' test",
    "test:integration": "pnpm --filter './tests/integration' test",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.4"
}
